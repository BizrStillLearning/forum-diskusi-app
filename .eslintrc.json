{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "globals": {
    "cy": true
  },
  "extends": [
    "dicodingacademy",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaFeatures": { "jsx": true },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "linebreak-style": "off"
  },
  "settings": {
    "react": { "version": "detect" }
  }
}